#!/usr/bin/env python3
"""
letcook — let them cook

A tool-agnostic CLI for running autonomous producer/evaluator loops
with AI coding assistants.
"""

import os
import sys
from pathlib import Path

# Bootstrap: re-exec under the bundled venv if rich isn't available
_VENV_PYTHON = Path(__file__).resolve().parent.parent / ".venv" / "bin" / "python"
if _VENV_PYTHON.exists():
    try:
        import rich  # noqa: F401
    except ImportError:
        os.execv(str(_VENV_PYTHON), [str(_VENV_PYTHON)] + sys.argv)

try:
    import rich  # noqa: F401
except ImportError:
    print("Error: 'rich' is required. Install it with: pip install rich")
    sys.exit(1)

from letcook_cli.cli import main

if __name__ == "__main__":
    main()
